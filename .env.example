# Local development only. Replace before using outside your machine.
POSTGRES_DB=kol_intelligence
POSTGRES_USER=kol
POSTGRES_PASSWORD=kol_local_dev
API_PORT=8000
AI_PORT=8001
# Host Python processes use these; Compose overrides container addresses.
DATABASE_URL=postgresql://kol:kol_local_dev@localhost:5432/kol_intelligence
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
AI_SERVICE_URL=http://localhost:8001
MODEL_VERSION=rules-v1
YOUTUBE_API_KEY=

# Airflow local UI: admin / airflow_local_dev (initialization preserves existing credentials).
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_PASSWORD=airflow_local_dev
AIRFLOW_DB_PASSWORD=airflow_local_dev
AIRFLOW_JWT_SECRET=kol-airflow-local-development-secret

